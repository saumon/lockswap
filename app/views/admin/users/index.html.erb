<% content_for :title, t(".title") %>

<%# 020 research.md R1: an advancing frame navigation caches the page snapshot
    for the address being left, taken after the frame has already been
    re-drawn — so without this a Back visit could show a stale filtered list
    under a URL that no longer matches it. Mirrors locker_wishes/index.html.erb
    (feature 017), which found and fixed the same thing. %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<%# 013 User Story 2: who is registered on this site, and who was first.
    020: plus their current floor, locker and wish (FR-001–FR-003), and four
    filters over the list (FR-004).
    028 FR-001: this screen is read-only — granting and revoking administrator
    rights both live on each account's own detail screen now, reached via the
    email link below. %>
<div class="stack">
  <%# 021: the title leaves the card, like every other screen's. %>
  <div class="page-head">
    <h1 class="page-title"><%= t(".heading") %></h1>
  </div>

  <div id="admin-user-directory" class="card stack-tight">

    <%# 020 FR-010: only this frame changes when a filter is applied; the card
        above it and the viewer's scroll position stay put. data-turbo-action
        "advance" pushes the filtered address into history so the view stays
        shareable and reachable with back/forward, and frame_history_controller
        (feature 017, reused unchanged) is what makes Back actually re-render
        it — see research.md R1. %>
    <turbo-frame id="admin-user-directory-list" data-turbo-action="advance"
                 data-controller="frame-history">
      <%# FR-004: the four filters sit with the list they narrow. %>
      <div id="admin-user-directory-filters" class="filter-bar">
        <%= render "admin/users/floor_filter", filter: @current_floor_filter, axis: :current_floor,
              label: t(".current_floor_label"), all_label: t(".all_floors") %>
        <%= render "admin/users/floor_filter", filter: @role_filter, axis: :role,
              label: t(".role_label"), all_label: t(".all_roles") %>
        <%= render "admin/users/text_filter", axis: :current_locker, label: t(".current_locker_label") %>
        <%= render "admin/users/text_filter", axis: :email, label: t(".email_label") %>
      </div>

      <%# 012 FR-005: a table above the breakpoint, one labelled card per account
        below it, from the same markup rendered once — so both forms show the
        same accounts in the same order, because there is only one order.

        The explicit roles are what keep that safe: changing an element's display
        drops the implicit table roles, and a screen reader has to meet each
        account as a set of labelled fields either way (012 FR-005d). %>
    <%# 020 FR-011: viewing this screen already requires being a registered
        administrator, so @users can never be empty when no filter is set —
        the only empty state reachable here is the filtered one
        (data-model.md "No-Match State"). %>
    <% if @users.any? %>
    <div class="table-scroll">
      <table class="data-table" role="table">
        <thead>
          <tr role="row">
            <th scope="col" role="columnheader"><%= t(".email_header") %></th>
            <th scope="col" role="columnheader"><%= t(".joined_header") %></th>
            <%# 020 FR-001/FR-002/FR-003: the same three facts the account's own
                homepage and the locker wishes screen already show, so the
                administrator no longer has to leave this screen to see them. %>
            <th scope="col" role="columnheader"><%= t(".floor_header") %></th>
            <th scope="col" role="columnheader"><%= t(".locker_header") %></th>
            <th scope="col" role="columnheader"><%= t(".wish_header") %></th>
            <%# FR-012: its own column rather than a mark tacked onto the email,
                so the one row that differs says how it differs. %>
            <th scope="col" role="columnheader"><%= t(".role_header") %></th>
          </tr>
        </thead>

        <tbody>
          <% @users.each do |user| %>
            <tr id="admin-user-row-<%= user.id %>" role="row">
              <%# 027 FR-001: a link within the row is the navigable element, not
                  the row as a whole (Clarifications) — plain link semantics need
                  no JavaScript and are keyboard-operable by construction.
                  data-turbo-frame "_top": this row sits inside the
                  #admin-user-directory-list turbo-frame, so without it Turbo
                  would look for a matching frame in the detail screen's response
                  (there is none) and silently do nothing. %>
              <td class="strong data-value" role="cell" data-label="<%= t(".email_header") %>">
                <%= link_to user.email, admin_user_path(user), id: "admin-user-row-#{user.id}-detail-link",
                      data: { turbo_frame: "_top" } %>
              </td>
              <td class="meta data-value" role="cell" data-label="<%= t(".joined_header") %>"><%= l user.created_at, format: :long %></td>

              <%# 020 FR-001: the same floor the account's own homepage shows.
                  saved_floor, not floor: while a rejected edit elsewhere is being
                  re-displayed the attribute holds unsaved input, and this screen
                  must only ever report what is actually on file. %>
              <td id="admin-user-row-<%= user.id %>-floor" role="cell" data-label="<%= t(".floor_header") %>"
                  class="data-value <%= "detail-value-empty" if user.saved_floor.blank? %>">
                <%= user.saved_floor.presence || t(".not_set") %>
              </td>

              <%# 020 FR-002: "No locker assigned" reuses the exact wording the
                  homepage and locker wishes screen already use for the same
                  state, rather than a third way of saying it. %>
              <td id="admin-user-row-<%= user.id %>-locker" role="cell" data-label="<%= t(".locker_header") %>"
                  class="data-value <%= "detail-value-empty" if user.saved_locker_number.blank? %>">
                <%= user.saved_locker_number.presence || t("home.locker_profile.no_locker_assigned") %>
              </td>

              <%# 020 FR-003: user.locker_wish is eager-loaded on the index query
                  (Admin::UsersController#index), so this costs no per-row query. %>
              <td id="admin-user-row-<%= user.id %>-wish" role="cell" data-label="<%= t(".wish_header") %>"
                  class="data-value <%= "detail-value-empty" unless user.locker_wish %>">
                <% if user.locker_wish %>
                  <%= t(".looking_for_floor", floor: user.locker_wish.saved_floor) %>
                <% else %>
                  <%= t(".not_looking_for_a_locker") %>
                <% end %>
              </td>

              <%# 008 FR-025: the tint decorates the word, it does not replace it —
                  "Admin" is what carries the meaning, for a reader who cannot
                  tell the badge's colour from any other. %>
              <td role="cell" data-label="<%= t(".role_header") %>" class="<%= "detail-value-empty" unless user.admin? %>">
                <% if user.admin? %>
                  <%# The badge and the line below it are one value, so they are
                      wrapped as one: below the breakpoint each child of a cell
                      becomes its own grid item, and a loose second child drops
                      into the label column. %>
                  <div class="cell-stack">
                    <%# 015 FR-008: the badge is identical on every administrator
                        row. Rights obtained by grant are not lesser rights, and
                        nothing here may suggest they are. %>
                    <span class="badge badge-info"><%= t(".role_choices.admin") %></span>

                    <%# 015 FR-018: where the rights came from, beneath the badge
                        rather than beside it — one fact about the account, not a
                        second kind of administrator. %>
                    <p class="meta">
                      <% if user.admin_rights_granted? %>
                        <% if user.admin_granted_by %>
                          <%= t(".granted_by", email: user.admin_granted_by.email, date: l(user.admin_granted_at, format: :long)) %>
                        <% else %>
                          <%# FR-019: the grantor's account is gone, the grant is
                              not. Saying so beats showing a blank where a name
                              was. %>
                          <%= t(".granted_account_removed", date: l(user.admin_granted_at, format: :long)) %>
                        <% end %>
                      <% else %>
                        <%= t(".first_registration") %>
                      <% end %>
                    </p>
                  </div>
                <% else %>
                  —
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% else %>
      <%# Distinct id from any per-row content, so a regression cannot satisfy
          this selector while showing the wrong message. %>
      <p id="admin-user-directory-no-match" class="empty-state">
        <%= t(".no_match") %>
      </p>
    <% end %>
    </turbo-frame>
  </div>
</div>
