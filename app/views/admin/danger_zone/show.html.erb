<% content_for :title, t(".title") %>

<%# 016 User Story 1: the settings whose reach is the whole site rather than one
    account. Today that is two settings — the site language (025) and which
    email domains may register — and the screen is named for the class of
    setting rather than for either one, because what belongs here is anything
    with the same blast radius. %>
<div class="stack">
  <%# 021: the title leaves the card, like every other screen's. %>
  <div class="page-head">
    <h1 class="page-title"><%= t(".title") %></h1>
  </div>

  <%# 025 User Story 1: the site-wide language, above the domains section —
      the newer setting leads, and this is the only place it can be changed
      (FR-002, FR-011). %>
  <div id="danger-zone-language" class="card card--alert stack-tight">
    <p class="meta">
      <%= t(".language_explanation") %>
    </p>

    <%= render "devise/shared/error_messages", resource: @site_language_setting %>

    <%# FR-003: exactly two choices, offered as a closed select rather than free
        text — there is no third option for an administrator to type. %>
    <%= form_with model: @site_language_setting, url: admin_danger_zone_path, method: :patch,
                  html: { class: "stack-tight", novalidate: true } do |f| %>
      <div class="field">
        <%= f.label :language, class: "field-label" %>
        <%= f.select :language,
              options_for_select(
                [ [ t(".languages.fr"), "fr" ], [ t(".languages.en"), "en" ] ],
                @site_language_setting.language
              ),
              {}, class: "field-input" %>
      </div>

      <%= f.submit t(".save_language_button"), class: "btn btn-primary" %>
    <% end %>
  </div>

  <%# 030 User Story 1: the floors that exist in the building. Once saved, every
      floor field on the site offers exactly these, in this order (FR-004), so
      the list is edited as the one line the super admin thinks of it as. %>
  <div id="danger-zone-floors" class="card card--alert stack-tight">
    <p class="meta">
      <%= t(".floors_explanation") %>
    </p>

    <%# FR-006 said in words: before the first save the site behaves as it
        always has, and the screen states that rather than showing an empty
        field and leaving the consequence to be inferred. Read from the saved
        list, so a refused first attempt does not hide it. %>
    <% unless @site_floor_list.floors_in_database.present? %>
      <p id="danger-zone-floors-empty" class="detail-value-empty">
        <%= t(".floors_empty") %>
      </p>
    <% end %>

    <%= render "devise/shared/error_messages", resource: @site_floor_list %>

    <%# novalidate: the server decides what is valid, as on every form here. %>
    <%= form_with model: @site_floor_list, url: admin_floor_list_path, method: :patch,
                  html: { class: "stack-tight", novalidate: true } do |f| %>
      <div class="field">
        <%= f.label :floors_text, class: "field-label" %>
        <%= f.text_field :floors_text, autocomplete: "off",
              aria: { describedby: "site_floor_list_floors_hint" }, class: "field-input" %>
        <p id="site_floor_list_floors_hint" class="field-hint">
          <%= t(".floors_hint") %>
        </p>
      </div>

      <%= f.submit t(".save_floors_button"), class: "btn btn-primary" %>
    <% end %>
  </div>

  <%# 030 User Story 3: the format every entered locker number must follow,
      written as a regular expression, with the reference examples below it so
      the super admin need not know the notation beforehand (FR-012). %>
  <div id="danger-zone-locker-format" class="card card--alert stack-tight">
    <p class="meta">
      <%= t(".format_explanation") %>
    </p>

    <%# Read from the saved row, so a refused save does not claim a format is in
        force that was never stored. %>
    <% if @locker_number_format.pattern_in_database.blank? %>
      <p id="danger-zone-locker-format-empty" class="detail-value-empty">
        <%= t(".format_empty") %>
      </p>
    <% end %>

    <%= render "devise/shared/error_messages", resource: @locker_number_format %>

    <%= form_with model: @locker_number_format, url: admin_locker_number_format_path, method: :patch,
                  html: { class: "stack-tight", novalidate: true } do |f| %>
      <%# The pattern is a measured value in the design's sense — it is read
          character by character — so it is set in the mono face (.data-value),
          and spellcheck is off because none of it is a word. %>
      <div class="field">
        <%= f.label :pattern, class: "field-label" %>
        <%= f.text_field :pattern, autocomplete: "off", spellcheck: false,
              aria: { describedby: "locker_number_format_pattern_hint" }, class: "field-input data-value" %>
        <p id="locker_number_format_pattern_hint" class="field-hint">
          <%= t(".pattern_hint") %>
        </p>
      </div>

      <div class="field">
        <%= f.label :description, class: "field-label" %>
        <%= f.text_field :description, autocomplete: "off",
              aria: { describedby: "locker_number_format_description_hint" }, class: "field-input" %>
        <p id="locker_number_format_description_hint" class="field-hint">
          <%= t(".description_hint") %>
        </p>
      </div>

      <%= f.submit t(".save_format_button"), class: "btn btn-primary" %>
    <% end %>

    <%# FR-012/SC-004: the examples. Each sample's result is computed with the
        same LockerNumberFormat#matches? that enforces the saved format, never
        written down, so the table cannot say something the site does not do.
        The same table construction as the domains list below — explicit roles
        and data-label — so it becomes one labelled card per pattern below the
        breakpoint. Every result is a word on a badge: colour is never the only
        signal. The table is named by a label above it rather than a <caption>,
        which centres itself — every heading on the site sits flush left. %>
    <p id="locker-format-examples-label" class="field-label"><%= t(".examples_caption") %></p>
    <div class="table-scroll">
      <table id="locker-format-examples" class="data-table" role="table"
             aria-labelledby="locker-format-examples-label">
        <thead>
          <tr role="row">
            <th scope="col" role="columnheader"><%= t(".example_pattern_header") %></th>
            <th scope="col" role="columnheader"><%= t(".example_meaning_header") %></th>
            <th scope="col" role="columnheader"><%= t(".example_samples_header") %></th>
          </tr>
        </thead>

        <tbody>
          <% LockerNumberFormat::EXAMPLES.each do |example| %>
            <% example_format = LockerNumberFormat.new(pattern: example[:pattern]) %>
            <tr role="row">
              <td class="data-value" role="cell" data-label="<%= t(".example_pattern_header") %>"><%= example[:pattern] %></td>
              <td role="cell" data-label="<%= t(".example_meaning_header") %>">
                <%= t(".format_examples.#{example[:key]}") %>
              </td>
              <td role="cell" data-label="<%= t(".example_samples_header") %>">
                <span class="cell-stack">
                  <% example[:samples].each do |sample| %>
                    <% accepted = example_format.matches?(sample) %>
                    <span class="locker-format-sample">
                      <span class="data-value"><%= sample %></span>
                      <span class="badge <%= accepted ? "badge-success" : "badge-error" %>">
                        <%= accepted ? t(".format_examples.accepted") : t(".format_examples.refused") %>
                      </span>
                    </span>
                  <% end %>
                </span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div id="danger-zone-allowed-domains" class="card card--alert stack-tight">

    <%# FR-004 said in words. "No domains configured" and "anybody may register"
        are the same fact, and an administrator should not have to know that to
        read the screen — so the consequence is stated, not the row count. %>
    <p class="meta">
      <%= t(".domains_explanation") %>
    </p>

    <%# The rejected entry's reason, in the site's existing form-error component.
        Reused rather than restyled: it is the same kind of message as every other
        refused form on the site, and Constitution III asks for the established
        pattern where one already solves the problem. %>
    <%= render "devise/shared/error_messages", resource: @allowed_email_domain %>

    <% if @allowed_email_domains.any? %>
      <%# 012 FR-005: a table above the breakpoint, one labelled card per domain
          below it, from the same markup rendered once. The explicit roles are
          what keep that safe — changing an element's display drops the implicit
          table roles, and a screen reader has to meet each row as a set of
          labelled fields either way. %>
      <div class="table-scroll">
        <table class="data-table" role="table">
          <thead>
            <tr role="row">
              <th scope="col" role="columnheader"><%= t(".domain_header") %></th>
              <th scope="col" role="columnheader"><%= t(".added_header") %></th>
              <th scope="col" role="columnheader"><%= t(".actions_header") %></th>
            </tr>
          </thead>

          <tbody>
            <% @allowed_email_domains.each do |allowed_email_domain| %>
              <tr id="allowed-email-domain-row-<%= allowed_email_domain.id %>" role="row">
                <td class="strong" role="cell" data-label="<%= t(".domain_header") %>"><%= allowed_email_domain.domain %></td>
                <td class="meta" role="cell" data-label="<%= t(".added_header") %>">
                  <%= l allowed_email_domain.created_at, format: :long %>
                </td>
                <td role="cell" data-label="<%= t(".actions_header") %>">
                  <%# 016 User Story 2: the way back. Guarded by the same
                      confirmation construction as "Grant admin rights" — both
                      `confirm` and `turbo_confirm`, the first being the fallback
                      where Turbo has not loaded — because removing a domain is
                      the same class of act: one click, immediate effect on who
                      may join the site.

                      The message names the domain and, when this is the last one,
                      says what removing it opens up. The accessible name names it
                      too: a column of buttons all reading "Remove" tells a screen
                      reader which row it is on only by position. %>
                  <% message = if @allowed_email_domains.one?
                       t(".remove_confirm_last", domain: allowed_email_domain.domain)
                     else
                       t(".remove_confirm", domain: allowed_email_domain.domain)
                     end %>
                  <%= button_to t(".remove_button"),
                        admin_allowed_email_domain_path(allowed_email_domain),
                        method: :delete,
                        class: "btn btn-secondary btn-sm",
                        aria: { label: t(".remove_aria_label", domain: allowed_email_domain.domain) },
                        data: { confirm: message, turbo_confirm: message } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%# The empty state is a statement, not a blank table: FR-004 is in force
          right now, and this is the screen that has to say so. %>
      <p id="danger-zone-allowed-domains-empty" class="detail-value-empty">
        <%= t(".domains_empty") %>
      </p>
    <% end %>

    <%# FR-003: one domain per submission, saved as it is entered rather than
        collected into a pending list and saved later (spec Assumptions). There is
        no draft state to lose, and no "unsaved changes" for an administrator to
        walk away from.

        novalidate: the server decides what is valid, so every refusal is reported
        the same way — as the locker profile form does, and for the same reason. %>
    <%= form_with model: @allowed_email_domain, url: admin_allowed_email_domains_path,
                  html: { class: "stack-tight", novalidate: true } do |f| %>
      <div class="field">
        <%= f.label :domain, class: "field-label" %>
        <%= f.text_field :domain, autocomplete: "off", inputmode: "url",
              aria: { describedby: "allowed_email_domain_hint" }, class: "field-input" %>
        <p id="allowed_email_domain_hint" class="field-hint">
          <%= t(".domain_hint") %>
        </p>
      </div>

      <%= f.submit t(".add_domain_button"), class: "btn btn-primary" %>
    <% end %>
  </div>
</div>
