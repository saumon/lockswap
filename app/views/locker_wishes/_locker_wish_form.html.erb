<%# 003 FR-006/FR-007: one field — the floor being looked for. The same partial
    serves the first declare and every later change, so both go through the same
    validation and report failures the same way. %>
<%= render "devise/shared/error_messages", resource: @locker_wish %>

<%# novalidate: the server decides what is valid, so every failure is reported the
    same way rather than some by the browser and some by the app. %>
<%= form_with model: @locker_wish, url: locker_wish_path, method: :post,
              html: { class: "space-y-5", novalidate: true } do |f| %>
  <div>
    <%= f.label :floor, class: "block text-sm font-medium text-slate-700" %>
    <%= f.text_field :floor, autocomplete: "off",
          aria: { describedby: "locker_wish_floor_hint" },
          class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-slate-500 focus:outline-none focus:ring-2 focus:ring-slate-400" %>
    <p id="locker_wish_floor_hint" class="mt-1 text-sm text-slate-500">
      The floor you would like a locker on.
    </p>
  </div>

  <%= f.submit "Save my wish",
        class: "w-full cursor-pointer rounded-md bg-slate-900 px-4 py-2 font-medium text-white hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2" %>
<% end %>
