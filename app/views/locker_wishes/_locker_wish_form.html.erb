<%# 003 FR-006/FR-007: one field — the floor being looked for. The same partial
    serves the first declare and every later change, so both go through the same
    validation and report failures the same way. %>
<%= render "devise/shared/error_messages", resource: @locker_wish %>

<%# novalidate: the server decides what is valid, so every failure is reported the
    same way rather than some by the browser and some by the app. %>
<%= form_with model: @locker_wish, url: locker_wish_path, method: :post,
              html: { class: "stack-tight", novalidate: true } do |f| %>
  <div class="field">
    <%= f.label :floor, class: "field-label" %>
    <%= f.text_field :floor, autocomplete: "off",
          aria: { describedby: "locker_wish_floor_hint" }, class: "field-input" %>
    <p id="locker_wish_floor_hint" class="field-hint">
      The floor you would like a locker on.
    </p>
  </div>

  <%# 008 FR-018: no data-turbo-submits-with — see the note in
      app/views/home/_locker_profile_form.html.erb. Turbo's label swap on an
      <input type="submit"> interacts badly with the page cache, and this
      control's value is asserted on by locker_wish_test.rb. %>
  <%= f.submit "Save my wish", class: "btn btn-primary" %>
<% end %>
