<%# 003 FR-011: every active wish, with enough of each wisher's own locker details
    for a reader to judge whether a swap is worth proposing. The viewer's own wish
    is listed like anyone else's. %>
<div id="locker-wish-list" class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
  <h2 class="text-lg font-semibold tracking-tight">Everyone looking for a locker</h2>

  <% if @locker_wishes.any? %>
    <%# The table is the one thing here allowed to scroll sideways on a narrow
        screen; the page itself must not. %>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead>
          <tr class="border-b border-slate-200 text-slate-500">
            <th scope="col" class="py-2 pr-4 text-left font-medium">Looking for floor</th>
            <th scope="col" class="py-2 pr-4 text-left font-medium">Person</th>
            <th scope="col" class="py-2 pr-4 text-left font-medium">Their floor</th>
            <th scope="col" class="py-2 text-left font-medium">Their locker</th>
          </tr>
        </thead>

        <tbody>
          <% @locker_wishes.each do |wish| %>
            <% row_id = "locker-wish-row-#{wish.user_id}" %>
            <tr id="<%= row_id %>" class="border-b border-slate-100 last:border-0">
              <td id="<%= row_id %>-floor" class="py-3 pr-4 font-medium text-slate-900"><%= wish.floor %></td>
              <td id="<%= row_id %>-person" class="py-3 pr-4 text-slate-900"><%= wish.user.email %></td>

              <%# Edge Case: never having saved a floor is distinct from having no
                  locker, and neither is an error — both are plain status text. %>
              <td id="<%= row_id %>-current-floor"
                  class="py-3 pr-4 <%= wish.user.saved_floor.present? ? "text-slate-900" : "text-slate-500" %>">
                <%= wish.user.saved_floor.presence || "Not set" %>
              </td>

              <td id="<%= row_id %>-current-locker"
                  class="py-3 <%= wish.user.saved_locker_number.present? ? "text-slate-900" : "text-slate-500" %>">
                <%= wish.user.saved_locker_number.presence || "No locker assigned" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%# Acceptance Scenario 2: nobody looking is an ordinary state to report. %>
    <p id="locker-wish-list-empty" class="mt-4 text-slate-500">
      Nobody is looking for a locker right now.
    </p>
  <% end %>
</div>
