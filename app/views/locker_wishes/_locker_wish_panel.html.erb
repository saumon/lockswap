<%# 003 FR-005/FR-006: the entry point is a button, and the floor question appears
    only once it is clicked. <details> gives that disclosure keyboard and screen
    reader support without any JavaScript of its own, matching 002's edit control.
    A rejected submission reopens it, otherwise the error would have nowhere to
    show. %>
<div id="locker-wish-panel" class="disclosure">
  <% if @locker_wish.persisted? %>
    <div class="disclosure-body stack-tight">
      <h2 class="card-title">Your locker search</h2>

      <dl>
        <dt class="detail-term">Looking for a locker on floor</dt>
        <%# The floor on file, not the attribute: while a rejected change is being
            re-displayed the attribute holds the input still being corrected. %>
        <dd id="locker-wish-floor" class="detail-value"><%= @locker_wish.saved_floor %></dd>
      </dl>

      <%# FR-009: withdrawing is its own decision, separate from moving the wish
          to another floor, so it gets its own control rather than sharing the
          form below. %>
      <div class="row">
        <%= button_to "Cancel wish", locker_wish_path, method: :delete,
              class: "btn btn-secondary btn-sm", form: { data: { turbo_submits_with: "Cancelling…" } } %>
      </div>
    </div>

    <details class="disclosure-nested" <%= "open" if @locker_wish.errors.any? %>>
      <summary class="disclosure-summary">Change floor</summary>

      <div class="disclosure-body">
        <%= render "locker_wishes/locker_wish_form" %>
      </div>
    </details>
  <% else %>
    <details <%= "open" if @locker_wish.errors.any? %>>
      <summary class="disclosure-summary">I'm looking for a locker</summary>

      <div class="disclosure-body">
        <%= render "locker_wishes/locker_wish_form" %>
      </div>
    </details>
  <% end %>
</div>
