<%# 003 FR-005/FR-006: the entry point is a button, and the floor question appears
    only once it is clicked. <details> gives that disclosure keyboard and screen
    reader support without any JavaScript of its own, matching 002's edit control.
    A rejected submission reopens it, otherwise the error would have nowhere to
    show. %>
<div id="locker-wish-panel" class="disclosure">
  <% if @locker_wish.persisted? %>
    <div class="disclosure-body stack-tight">
      <h2 class="card-title"><%= t(".title") %></h2>

      <dl class="detail-inline">
        <dt class="detail-term"><%= t(".looking_on_floor") %></dt>
        <%# The floor on file, not the attribute: while a rejected change is being
            re-displayed the attribute holds the input still being corrected. %>
        <dd id="locker-wish-floor" class="detail-value"><%= @locker_wish.saved_floor %></dd>
      </dl>

      <%# FR-009: withdrawing is its own decision, separate from moving the wish
          to another floor, so it gets its own control rather than sharing the
          form below. %>
      <%# 017 FR-019: the fields carrying the filters in force are not here — they
          are inside the frame, and reach this form by its id. See the note on them
          in locker_wishes/_locker_wish_list. %>
      <div class="row">
        <%= button_to t(".cancel_wish"), locker_wish_path, method: :delete,
              class: "btn btn-secondary btn-sm",
              form: { id: LockerWishesController::CANCEL_FORM_ID,
                      data: { turbo_submits_with: t(".cancelling") } } %>
      </div>
    </div>

    <details class="disclosure-nested" <%= "open" if @locker_wish.errors.any? %>>
      <summary class="disclosure-summary"><%= t(".change_floor") %></summary>

      <div class="disclosure-body">
        <%# 026 FR-008: a viewer with a wish never sees the declare intention —
            this disclosure only opens on its own errors.any?, never on
            @open_wish_form. No controller guard is needed for that: the branch
            this partial sits in already does not render for anyone the
            intention would apply to (research.md R6). %>
        <%= render "locker_wishes/locker_wish_form", autofocus: false %>
      </div>
    </details>
  <% else %>
    <%# 026 FR-002/FR-004/FR-006: @open_wish_form is the one-arrival intention
        set by LockerWishesController#new — present only on the request right
        after it, absent on a reload, Back/Forward, a bookmark, or the menu.
        Folded into the same `open` condition as a rejected submission,
        because both are "the person needs to see this form right now." %>
    <details <%= "open" if @open_wish_form || @locker_wish.errors.any? %>>
      <summary class="disclosure-summary"><%= t(".looking_for_a_locker") %></summary>

      <div class="disclosure-body">
        <%= render "locker_wishes/locker_wish_form", autofocus: @open_wish_form %>
      </div>
    </details>
  <% end %>
</div>
