<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "LockSwap" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="LockSwap">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# 008 FR-006: the brand mark, not the scaffold placeholder. %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <meta name="theme-color" content="#0E2A47">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%# 008: sign-in and sign-up opt out of the header. They already lead with the
        full stacked lock-up, so a header would put the brand on the page twice;
        and the bar carries nothing else for a visitor who is not signed in — the
        navigation and the sign-out control are both behind user_signed_in?. Set
        explicitly by those two templates rather than inferred from the session,
        so a future public page still gets a header unless it asks not to. %>
    <% unless content_for?(:hide_site_header) %>
      <header class="site-header">
        <nav class="site-nav" aria-label="Main">
          <%# The brand is the way back to the homepage, as it is on most sites.
              A visitor who is not logged in lands on the login page instead, the
              same as any other attempt to reach the homepage. %>
          <%= render "shared/brand_lockup" %>

          <%# FR-009: the sign-out control is only meaningful for a signed-in visitor. %>
          <% if user_signed_in? %>
            <div class="row">
              <%# 003 FR-005: the "I'm looking for a locker" button lives on that page,
                  so it has to be reachable from wherever the user happens to be. %>
              <%= link_to "Locker wishes", locker_wishes_path, class: "site-nav-link" %>

              <%# 004 FR-015: the history is a separate screen, so it needs a way in
                  from anywhere too. %>
              <%= link_to "Proposal history", locker_swap_proposals_path, class: "site-nav-link" %>

              <%# 008: the email is what truncates on a narrow screen — never the
                  brand, never the controls. %>
              <span class="site-nav-identity"><%= current_user.email %></span>

              <%= button_to "Log out", destroy_user_session_path, method: :delete,
                    class: "btn btn-secondary" %>
            </div>
          <% end %>
        </nav>
      </header>
    <% end %>

    <main class="site-main">
      <%= render "layouts/flash" %>

      <%# 008 FR-016: content eases in once per render. Turbo Drive replaces the
          body on navigation, so this replays without any JavaScript. %>
      <div class="page-enter">
        <%= yield %>
      </div>
    </main>
  </body>
</html>
