<%# Shared flash rendering so every page reports success and failure the same way.
    These sit in a fixed overlay rather than in the page flow: they appear and then
    dismiss themselves a few seconds later, so occupying layout space would shift
    the content underneath twice — once on arrival and again on departure. %>
<%
  notifications = [
    [ notice, "status", "toast-success" ],
    [ alert,  "alert",  "toast-error" ]
  ].select { |message, _role, _palette| message.present? }
%>

<% if notifications.any? %>
  <%# data-turbo-temporary keeps a spent message out of Turbo's page cache, so
      going back to an earlier page does not replay a notification the visitor
      has already read and dismissed. %>
  <%# Bottom right, fixed to the viewport (023, resolved in the 2026-09-20
      clarification — spec.md): clear of the navigation at every width without
      needing to know the header's height, and over the empty margin beside
      the content rather than over the content itself. The container's own
      max-width keeps it inside the viewport on a narrow screen rather than
      pushing it off an edge.

      `position: fixed` in application.css's .toast-layer rule takes the layer
      out of the page's flow entirely, on its own — notification_test still
      asserts <main>'s rectangle is identical with and without a message. %>
  <div data-turbo-temporary class="toast-layer" data-controller="toast-layer">
    <% notifications.each do |message, role, palette| %>
      <div class="toast pointer-events-auto <%= palette %>"
           role="<%= role %>"
           data-controller="notification"
           data-toast-layer-target="toast"
           data-notification-duration-value="<%= Rails.configuration.x.notification_auto_dismiss_ms %>"
           data-action="mouseenter->notification#pause
                        mouseleave->notification#resume
                        focusin->notification#pause
                        focusout->notification#resume">
        <%# Decorative only — role="status"/"alert" plus the message text already
            carry the meaning to assistive technology; an aria-label here would
            announce the type twice. Color is never the only signal (CLAUDE.md),
            so this is the icon half of that pair, not the whole of it. %>
        <% if palette == "toast-success" %>
          <svg class="toast-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.5" />
            <path d="M6 10.5l2.5 2.5L14 7.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        <% else %>
          <svg class="toast-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.5" />
            <path d="M10 6v5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
            <circle cx="10" cy="13.5" r="0.9" fill="currentColor" />
          </svg>
        <% end %>

        <span class="min-w-0 flex-1 break-words"><%= message %></span>

        <%# Tabbing to this button also holds the message open, so a keyboard
            user is never racing the countdown to reach it. %>
        <button type="button"
                aria-label="<%= t(".dismiss") %>"
                data-action="notification#dismiss"
                class="toast-dismiss">
          &times;
        </button>
      </div>
    <% end %>
  </div>
<% end %>
