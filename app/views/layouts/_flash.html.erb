<%# Shared flash rendering so every page reports success and failure the same way. %>
<% if notice.present? %>
  <p class="mb-6 rounded-md border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800" role="status"><%= notice %></p>
<% end %>

<% if alert.present? %>
  <p class="mb-6 rounded-md border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800" role="alert"><%= alert %></p>
<% end %>
