<%# 004 FR-007/FR-009: proposals of this user's that came back declined, with
    whatever the decliner said about it. Shown once — the controller marks them
    acknowledged as it hands them over — and kept afterwards in the history. %>
<div id="swap-proposals-declined" class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
  <h2 class="text-lg font-semibold tracking-tight">Proposals that were declined</h2>

  <ul class="mt-4 space-y-3">
    <% @recently_declined_sent.each do |proposal| %>
      <li id="swap-proposal-declined-<%= proposal.id %>"
          class="rounded-md border border-slate-200 p-4">
        <p class="text-slate-900">
          <span class="font-medium"><%= proposal.recipient.email %></span> declined your swap proposal
        </p>

        <%# The comment is optional, so its absence is simply nothing to show. %>
        <% if proposal.decline_comment.present? %>
          <p id="swap-proposal-declined-<%= proposal.id %>-comment" class="mt-2 text-slate-600">
            “<%= proposal.decline_comment %>”
          </p>
        <% end %>

        <p class="mt-1 text-sm text-slate-500">
          <%= l proposal.decided_at, format: :long if proposal.decided_at %>
        </p>
      </li>
    <% end %>
  </ul>
</div>
