<%# 004 FR-012/FR-013: the swap this user is committed to. The confirmation is
    the recipient's to give — they are the one who accepted — so the requester
    sees the same status without a control, and is told who it rests with. %>
<% counterpart = @exchange_in_progress.requester_id == current_user.id ? @exchange_in_progress.recipient : @exchange_in_progress.requester %>
<% viewer_is_recipient = @exchange_in_progress.recipient_id == current_user.id %>

<div id="swap-exchange-in-progress" class="card card--them stack-tight">
  <div class="row">
    <h2 class="card-title"><%= t(".title") %></h2>
    <span class="badge badge-success"><%= t(".accepted") %></span>
  </div>

  <div>
    <p><%= t(".swapping_with_html", email: content_tag(:span, counterpart.email, class: "strong")) %></p>
    <p class="meta">
      <%= t(".counterpart_details", floor: counterpart.saved_floor.presence || t(".not_set"),
            locker: counterpart.saved_locker_number.presence || t(".none_assigned")) %>
    </p>
    <%# 032 FR-002, research.md R2: a single-record screen, resolved directly
        here — the same "value on file" reader used above. %>
    <%= render "shared/zone_label",
          zone_name: LockerMapEntry.zone_name_for(counterpart.saved_floor, counterpart.saved_locker_number) %>
  </div>

  <% if viewer_is_recipient %>
    <p class="card-lead">
      <%= t(".confirm_instructions") %>
    </p>

    <%= button_to t(".confirm_button"),
          confirm_locker_swap_proposal_path(@exchange_in_progress), method: :patch,
          class: "btn btn-primary", form: { data: { turbo_submits_with: t(".confirming") } } %>
  <% else %>
    <p class="card-lead">
      <%= t(".waiting_for_their_confirmation", email: counterpart.email) %>
    </p>
  <% end %>
</div>
