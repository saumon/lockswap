<%# 004 FR-012/FR-013: the swap this user is committed to. The confirmation is
    the recipient's to give — they are the one who accepted — so the requester
    sees the same status without a control, and is told who it rests with. %>
<% counterpart = @exchange_in_progress.requester_id == current_user.id ? @exchange_in_progress.recipient : @exchange_in_progress.requester %>
<% viewer_is_recipient = @exchange_in_progress.recipient_id == current_user.id %>

<div id="swap-exchange-in-progress" class="card stack-tight">
  <div class="row">
    <h2 class="card-title">Exchange in progress</h2>
    <span class="badge badge-success">Accepted</span>
  </div>

  <div>
    <p>You are swapping lockers with <span class="strong"><%= counterpart.email %></span>.</p>
    <p class="meta">
      They have floor <%= counterpart.saved_floor.presence || "not set" %>,
      locker <%= counterpart.saved_locker_number.presence || "none assigned" %>.
    </p>
  </div>

  <% if viewer_is_recipient %>
    <p class="card-lead">
      Once you have actually exchanged lockers, confirm it here and both sets of
      details will be swapped.
    </p>

    <%= button_to "Confirm exchange completed",
          confirm_locker_swap_proposal_path(@exchange_in_progress), method: :patch,
          class: "btn btn-primary", form: { data: { turbo_submits_with: "Confirming…" } } %>
  <% else %>
    <p class="card-lead">
      <%= counterpart.email %> will confirm once the exchange has taken place.
    </p>
  <% end %>
</div>
