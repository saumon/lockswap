<%# 004 FR-005..FR-009: the proposals waiting on this user's answer. Accept is a
    single button; declining opens a <details> disclosure holding the optional
    comment, the same no-JavaScript pattern 002 and 003 use for deliberate
    actions. %>
<div id="swap-proposals-received" class="card card--them stack-tight">
  <h2 class="card-title"><%= t(".title") %></h2>

  <ul class="stack-tight">
    <% @received_pending_proposals.each do |proposal| %>
      <li id="swap-proposal-received-<%= proposal.id %>" class="tile tile--them">
        <div class="tile-head">
          <div>
            <p>
              <%= t(".wants_to_swap_html", email: content_tag(:span, proposal.requester.email, class: "strong data-value")) %>
            </p>
            <%# 032 FR-002, research.md R2: a single-record screen, resolved
                directly here — the same "value on file" reader below. Folded
                into the same line as floor/locker rather than the shared/
                _zone_label partial's own separate element: on this card the
                zone reads as one more fact about the locker, alongside floor
                and locker number, with the sent date moved to its own line
                below instead (French follow-up request, 2026-09-26). %>
            <% zone_name = LockerMapEntry.zone_name_for(proposal.requester.saved_floor, proposal.requester.saved_locker_number) %>
            <p id="swap-proposal-received-<%= proposal.id %>-details" class="meta">
              <% if zone_name %>
                <%= t(".proposal_details_with_zone", floor: proposal.requester.saved_floor.presence || t(".not_set"),
                      locker: proposal.requester.saved_locker_number.presence || t(".none_assigned"), zone: zone_name) %>
              <% else %>
                <%= t(".proposal_details", floor: proposal.requester.saved_floor.presence || t(".not_set"),
                      locker: proposal.requester.saved_locker_number.presence || t(".none_assigned")) %>
              <% end %>
            </p>
            <p id="swap-proposal-received-<%= proposal.id %>-sent-at" class="meta">
              <%= t(".sent_at", sent_at: l(proposal.created_at, format: :numeric_at)) %>
            </p>
          </div>

          <%= button_to t(".accept"), accept_locker_swap_proposal_path(proposal), method: :patch,
                class: "btn btn-primary btn-sm", form: { data: { turbo_submits_with: t(".accepting") } } %>
        </div>

        <details class="tile-disclosure">
          <summary class="tile-disclosure-summary"><%= t(".decline") %></summary>

          <%= form_with url: decline_locker_swap_proposal_path(proposal), method: :patch,
                        class: "stack-tight tile-disclosure-body" do |f| %>
            <%# The id has to carry the proposal's own id: several proposals can
                be waiting at once, and repeating one id across them would be
                invalid and would point every label at the first field. %>
            <% comment_field_id = "decline-comment-#{proposal.id}" %>
            <div class="field">
              <%= f.label :"locker_swap_proposal[decline_comment]", t(".decline_comment_label"),
                    for: comment_field_id, class: "field-label" %>
              <%= f.text_area :"locker_swap_proposal[decline_comment]", rows: 2,
                    id: comment_field_id, class: "field-input" %>
            </div>

            <%= f.submit t(".confirm_decline"), class: "btn btn-secondary btn-sm",
                  data: { turbo_submits_with: t(".declining") } %>
          <% end %>
        </details>
      </li>
    <% end %>
  </ul>
</div>
