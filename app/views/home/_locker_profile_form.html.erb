<%# 002 FR-005/FR-006: the floor and the locker number are always offered as two
    separate fields. The caller decides how this is surfaced — openly for someone
    who has nothing saved, behind the edit control for someone who has. %>
<%= render "devise/shared/error_messages", resource: current_user %>

<%# novalidate: the server decides what is valid, so every failure is reported
    the same way rather than some by the browser and some by the app. %>
<%= form_with model: current_user, url: locker_profile_path, method: :patch,
              html: { class: "stack-tight", novalidate: true } do |f| %>
  <div class="field">
    <%= f.label :floor, class: "field-label" %>
    <%= f.text_field :floor, autocomplete: "off", class: "field-input" %>
  </div>

  <div class="field">
    <%= f.label :locker_number, class: "field-label" %>
    <%= f.text_field :locker_number, autocomplete: "off",
          aria: { describedby: "locker_number_hint" }, class: "field-input" %>
    <%# FR-002/FR-008: say up front that this one is optional. %>
    <p id="locker_number_hint" class="field-hint">
      Leave empty if you have no locker assigned.
    </p>
  </div>

  <%# 008 FR-018: deliberately NO data-turbo-submits-with here.
      Turbo swaps this control's value attribute while the form is in flight, and
      a page snapshot taken during that window caches the button showing the busy
      label. A later restore then renders a button whose value no longer matches,
      and the next click lands on an element Turbo is about to replace — the
      submit is silently dropped. Reproduced against locker_profile_test.rb: the
      edit saved in isolation and did nothing once other tests had populated the
      cache. The in-progress cue for this form is the disabled/progress cursor
      rule in the stylesheet, which needs no attribute swap. %>
  <%= f.submit "Save locker details", class: "btn btn-primary" %>
<% end %>
