<% content_for :title, "Home" %>

<div class="space-y-6">
  <div class="rounded-lg border border-slate-200 bg-white p-8 shadow-sm">
    <h1 class="text-2xl font-semibold tracking-tight">Welcome to LockSwap</h1>
    <p class="mt-2 text-slate-600">
      You are logged in as <span class="font-medium text-slate-900"><%= current_user.email %></span>.
    </p>
  </div>

  <%# 002: the saved floor is what decides whether this user has been asked yet,
      so an empty locker number reads as "none assigned" rather than as an open
      prompt, and someone who has answered is not asked again on every visit. %>
  <% if current_user.saved_floor.present? %>
    <%= render "home/locker_profile" %>

    <%# FR-009: editing is deliberate, so the form sits behind this control. A
        rejected submission reopens it, otherwise the error would have nowhere to
        show. <details> gives the disclosure keyboard and screen reader support
        without any JavaScript of its own. %>
    <details class="rounded-lg border border-slate-200 bg-white shadow-sm" <%= "open" if current_user.errors.any? %>>
      <summary class="cursor-pointer rounded-lg px-6 py-4 font-medium text-slate-900 hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-400">
        Edit locker details
      </summary>

      <div class="border-t border-slate-200 p-6">
        <%= render "home/locker_profile_form" %>
      </div>
    </details>
  <% else %>
    <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="mb-4 text-lg font-semibold tracking-tight">Add your locker details</h2>
      <%= render "home/locker_profile_form" %>
    </div>
  <% end %>
</div>
