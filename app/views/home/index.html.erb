<% content_for :title, "Home" %>

<div class="stack">
  <div class="card stack-tight">
    <%# The brand name set in the brand's own two colours, the same treatment the
        header and the sign-in lock-up give it. It carries .brand-wordmark because
        that is what the accessibility audit keys its logotype exemption on — the
        green is 2.66:1 and is allowed on a brand name and nowhere else. No
        whitespace between the two halves: "LockSwap" has to keep reading as one
        word, which is what every log-in assertion in the suite looks for. %>
    <h1 class="page-title">Welcome to <span class="brand-wordmark brand-wordmark-inline"><span class="brand-wordmark-lock">Lock</span><span class="brand-wordmark-swap">Swap</span></span></h1>
    <p class="card-lead">
      You are logged in as <span class="strong"><%= current_user.email %></span>.
    </p>
  </div>

  <%# 004 FR-009: each swap section appears only when it has something to say, so
      a user with no proposals in either direction sees no swap content here.
      Proposals awaiting this user's answer come first — they are the ones that
      cannot move without them. %>
  <%= render "home/swap_exchange_in_progress" if @exchange_in_progress %>
  <%= render "home/swap_proposals_received" if @received_pending_proposals.any? %>
  <%= render "home/swap_proposals_sent" if @sent_pending_proposals.any? %>
  <%= render "home/swap_proposals_declined" if @recently_declined_sent.any? %>

  <%# 002: the saved floor is what decides whether this user has been asked yet,
      so an empty locker number reads as "none assigned" rather than as an open
      prompt, and someone who has answered is not asked again on every visit. %>
  <% if current_user.saved_floor.present? %>
    <%# 005 FR-003: while a proposal is outstanding these values are what the
        other party is answering, so the edit control gives way to the reason.
        A rejected submission still gets the form back — otherwise a request that
        reached the controller some other way would be refused with nowhere to
        read why. 009: the control now lives in the card, so what is withheld
        here is the card's pencil rather than a block of its own. %>
    <% locked = LockerSwapProposal.active_for?(current_user) && current_user.errors.empty? %>

    <%# 010 FR-001a: the block lives inside this branch deliberately. Someone who
        has not answered yet is being asked one question, and a second card
        inviting them to wish for a locker would compete with it — so the wish
        block waits until there are details to sit under.

        010 FR-012: and it sits directly above them. The proposal sections above
        are waiting on an answer, so they keep precedence; the locker card below
        is reference, so the wish goes in front of it. %>
    <%= render "home/locker_wish" %>

    <%= render "home/locker_profile", editable: !locked %>

    <% if locked %>
      <div id="locker-profile-locked" class="card">
        <p class="card-lead">
          Your floor and locker number cannot be changed while you have an active swap
          proposal. They can be edited again once it is declined, withdrawn, or completed.
        </p>
      </div>
    <% end %>
  <% else %>
    <div class="card stack-tight">
      <h2 class="card-title">Add your locker details</h2>
      <%# 009 FR-001: only here is the choice offered — a first answer is the one
          place where "no locker" is still an open question. %>
      <%= render "home/locker_profile_form", show_no_locker_choice: true %>
    </div>
  <% end %>
</div>
