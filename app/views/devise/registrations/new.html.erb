<% content_for :title, "Create your account" %>

<div class="mx-auto w-full max-w-sm">
  <h1 class="mb-6 text-2xl font-semibold tracking-tight">Create your account</h1>

  <%= render "devise/shared/error_messages", resource: resource %>

  <%# FR-001: an email address and a password are all that is required to sign up. %>
  <%# novalidate: the server validates every field, so all four failure modes
      (blank, bad format, duplicate email, short password) are reported the same
      way instead of some by the browser and some by the app. %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
               html: { class: "space-y-5", novalidate: true }) do |f| %>
    <div>
      <%= f.label :email, class: "block text-sm font-medium text-slate-700" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email",
            class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-slate-500 focus:outline-none focus:ring-2 focus:ring-slate-400" %>
    </div>

    <div>
      <%= f.label :password, class: "block text-sm font-medium text-slate-700" %>
      <%= f.password_field :password, autocomplete: "new-password",
            aria: { describedby: "password_hint" },
            class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-slate-500 focus:outline-none focus:ring-2 focus:ring-slate-400" %>
      <%# FR-002: state the 8-character minimum up front rather than only on failure. %>
      <p id="password_hint" class="mt-1 text-sm text-slate-500">
        <%= @minimum_password_length %> characters minimum
      </p>
    </div>

    <%= f.submit "Create account",
          class: "w-full cursor-pointer rounded-md bg-slate-900 px-4 py-2 font-medium text-white hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2" %>
  <% end %>

  <p class="mt-6 text-sm text-slate-600">
    Already have an account?
    <%= link_to "Log in", new_user_session_path, class: "font-medium text-slate-900 underline underline-offset-2 hover:no-underline" %>
  </p>
</div>
