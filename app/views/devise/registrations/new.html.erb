<% content_for :title, "Create your account" %>
<% content_for :hide_site_header, true %>

<div class="auth-page">
  <%# 008 FR-003: sign-in and sign-up are the full-brand screens. %>
  <%= render "shared/brand_stacked" %>

  <div class="card stack">
    <h1 class="page-title">Create your account</h1>

    <%= render "devise/shared/error_messages", resource: resource %>

    <%# FR-001: an email address and a password are all that is required to sign up. %>
    <%# novalidate: the server validates every field, so all four failure modes
        (blank, bad format, duplicate email, short password) are reported the same
        way instead of some by the browser and some by the app. %>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
                 html: { class: "stack-tight", novalidate: true }) do |f| %>
      <div class="field">
        <%= f.label :email, class: "field-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "field-input" %>
      </div>

      <div class="field">
        <%= f.label :password, class: "field-label" %>
        <%= f.password_field :password, autocomplete: "new-password",
              aria: { describedby: "password_hint" }, class: "field-input" %>
        <%# FR-002: state the 8-character minimum up front rather than only on failure. %>
        <p id="password_hint" class="field-hint">
          <%= @minimum_password_length %> characters minimum
        </p>
      </div>

      <%= f.submit "Create account", class: "btn btn-primary w-full", data: { turbo_submits_with: "Creating…" } %>
    <% end %>

    <p class="meta">
      Already have an account?
      <%= link_to "Log in", new_user_session_path, class: "auth-link" %>
    </p>
  </div>
</div>
