<%# locals: (password_change:) %>
<%#
  035: changing the password from the account page (spec US1, US3; contract
  "Screen"). Three fields, each with the 014 show/hide control (FR-003,
  FR-004), posted to RegistrationsController#update_password.

  Errors come back per field as well as in the summary (FR-012). The form object
  never renders a typed value back (password_field has no value), so a refused
  submission always comes back with all three fields empty; length and match are
  checked in the browser first so that those mistakes cost no typing
  (clarification Q2, research.md R7). The live texts are the server's own
  messages, rendered here, so the two cannot say different things.
%>
<%
  length = Devise.password_length
  password_attributes = "activemodel.errors.models.password_change.attributes.password"
  too_short = password_change.errors.full_message(:password, t("#{password_attributes}.too_short", count: length.min))
  too_long = password_change.errors.full_message(:password, t("#{password_attributes}.too_long", count: length.max))
  mismatch = password_change.errors.full_message(:password_confirmation,
               t("activemodel.errors.models.password_change.attributes.password_confirmation.confirmation"))
  field_error = ->(attribute) { password_change.errors.full_messages_for(attribute).first }
%>
<div class="card card--you stack" id="password-change">
  <h2 class="card-title"><%= t("devise.registrations.edit.password_section_title") %></h2>

  <%# FR-014, research.md R8: in the page, not a toast. A toast dismisses itself,
      and three things have to be read here. Focused on arrival (analyze I2):
      Turbo focuses the first [autofocus] after every visit. %>
  <% if flash[:password_changed] %>
    <div class="form-success" role="status" tabindex="-1" autofocus>
      <h3 class="form-success-title"><%= t("devise.registrations.edit.password_changed_title") %></h3>
      <ul class="form-success-list">
        <li><%= t("devise.registrations.edit.password_changed_active") %></li>
        <li><%= t("devise.registrations.edit.password_changed_sessions") %></li>
        <li><%= t("devise.registrations.edit.password_changed_notified", email: resource.email) %></li>
      </ul>
    </div>
  <% end %>

  <%= render "devise/shared/error_messages", resource: password_change, focus: true %>

  <%= form_with model: password_change, scope: :password_change, url: user_account_password_path,
                method: :patch, class: "stack-tight",
                html: { novalidate: true },
                data: { controller: "password-confirmation",
                        action: "submit->password-confirmation#guard",
                        password_confirmation_minimum_value: length.min,
                        password_confirmation_maximum_value: length.max,
                        password_confirmation_too_short_value: too_short,
                        password_confirmation_too_long_value: too_long } do |f| %>
    <div class="field">
      <%= f.label :current_password, class: "field-label" %>
      <%= render "devise/shared/password_field", f: f, attribute: :current_password,
            subject: t("devise.registrations.edit.current_password_subject"),
            autocomplete: "current-password",
            aria: { describedby: ("password_change_current_password_error" if field_error.(:current_password)) },
            data: {} %>
      <% if (message = field_error.(:current_password)) %>
        <p id="password_change_current_password_error" class="field-error"><%= message %></p>
      <% end %>
    </div>

    <div class="field">
      <%= f.label :password, class: "field-label" %>
      <%= render "devise/shared/password_field", f: f, attribute: :password,
            subject: t("devise.registrations.edit.new_password_subject"),
            aria: { describedby: "password_change_password_hint password_change_password_error" },
            data: { password_confirmation_target: "password",
                    action: "blur->password-confirmation#measure input->password-confirmation#recheck" } %>
      <%# FR-005: the rule, stated before anyone breaks it. %>
      <p id="password_change_password_hint" class="field-hint">
        <%= t("devise.shared.password_hint", count: length.min) %>
      </p>
      <p id="password_change_password_error" class="field-error" <%= "hidden" unless field_error.(:password) %>
         data-password-confirmation-target="lengthHint"><%= field_error.(:password) || too_short %></p>
    </div>

    <div class="field">
      <%= f.label :password_confirmation, class: "field-label" %>
      <%= render "devise/shared/password_field", f: f, attribute: :password_confirmation,
            subject: t("devise.registrations.edit.new_password_confirmation_subject"),
            aria: { describedby: "password_change_password_confirmation_error" },
            data: { password_confirmation_target: "confirmation",
                    action: "blur->password-confirmation#confirm input->password-confirmation#recheck" } %>
      <p id="password_change_password_confirmation_error" class="field-error"
         <%= "hidden" unless field_error.(:password_confirmation) %>
         data-password-confirmation-target="hint"><%= field_error.(:password_confirmation) || mismatch %></p>
    </div>

    <%# FR-023: disabled, and saying so, from the first submission. %>
    <%= f.submit t("devise.registrations.edit.password_submit"), class: "btn btn-primary",
          data: { turbo_submits_with: t("devise.registrations.edit.password_submitting") } %>
  <% end %>
</div>
