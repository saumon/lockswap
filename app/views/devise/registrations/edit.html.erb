<% content_for :title, t(".title") %>

<div class="auth-page">
  <div class="card stack">
    <h1 class="page-title"><%= t(".heading") %></h1>

    <%= render "devise/shared/error_messages", resource: resource %>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
                 html: { method: :put, class: "stack-tight" }) do |f| %>
      <div class="field">
        <%= f.label :email, class: "field-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "field-input" %>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <p class="field-hint"><%= t(".waiting_confirmation_for", email: resource.unconfirmed_email) %></p>
      <% end %>

      <div class="field">
        <%= f.label :password, class: "field-label" %>
        <%= f.password_field :password, autocomplete: "new-password",
              aria: { describedby: "edit_password_hint" }, class: "field-input" %>
        <p id="edit_password_hint" class="field-hint">
          <%= t(".leave_blank") %><% if @minimum_password_length %> — <%= t("devise.shared.password_hint", count: @minimum_password_length) %><% end %>
        </p>
      </div>

      <div class="field">
        <%= f.label :password_confirmation, class: "field-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "field-input" %>
      </div>

      <div class="field">
        <%= f.label :current_password, class: "field-label" %>
        <%= f.password_field :current_password, autocomplete: "current-password",
              aria: { describedby: "current_password_hint" }, class: "field-input" %>
        <p id="current_password_hint" class="field-hint">
          <%= t(".current_password_hint") %>
        </p>
      </div>

      <%= f.submit t(".submit"), class: "btn btn-primary", data: { turbo_submits_with: t(".submitting") } %>
    <% end %>
  </div>

  <div class="card stack-tight">
    <h2 class="card-title"><%= t(".cancel_account_title") %></h2>
    <p class="card-lead"><%= t(".unhappy") %></p>
    <div class="row">
      <%= button_to t(".cancel_account_button"), registration_path(resource_name),
            data: { confirm: t(".cancel_account_confirm"), turbo_confirm: t(".cancel_account_confirm") },
            method: :delete, class: "btn btn-destructive" %>
      <%= link_to t(".back"), :back, class: "btn btn-secondary" %>
    </div>
  </div>
</div>
