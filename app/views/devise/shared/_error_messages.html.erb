<%# 035 (analyze I2): `focus: true` makes the summary take focus when it is
    rendered — Turbo focuses the first [autofocus] after a render — so a refused
    submission is announced where the user's attention already is (FR-012).
    Opt-in: the other screens that render this are unchanged. %>
<% if resource.errors.any? %>
  <% focus = local_assigns.fetch(:focus, false) %>
  <div id="error_explanation" data-turbo-temporary role="alert" class="form-errors"
       <%= tag.attributes(tabindex: (-1 if focus), autofocus: focus) %>>
    <h2 class="form-errors-title">
      <%= I18n.t("errors.messages.not_saved",
                 count: resource.errors.count,
                 resource: resource.class.model_name.human.downcase) %>
    </h2>
    <ul class="form-errors-list">
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
