<% content_for :title, t(".title") %>
<% content_for :hide_site_header, true %>

<div class="auth-page">
  <%# 008 FR-003: sign-in and sign-up are the full-brand screens. %>
  <%= render "shared/brand_stacked" %>

  <div class="card stack">
    <h1 class="page-title"><%= t(".title") %></h1>

    <%# novalidate: a failed login is always answered by the same generic
        server-side message (FR-006), never by a browser-specific one. %>
    <%= form_for(resource, as: resource_name, url: session_path(resource_name),
                 html: { class: "stack-tight", novalidate: true }) do |f| %>
      <div class="field">
        <%= f.label :email, class: "field-label" %>
        <%= f.email_field :email, autocomplete: "email", class: "field-input" %>
      </div>

      <div class="field">
        <%= f.label :password, class: "field-label" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "field-input" %>
      </div>

      <%# 008 FR-018: Turbo swaps the label while the form is in flight, so the
          control says it is working rather than appearing frozen. %>
      <%= f.submit t(".submit"), class: "btn btn-primary w-full", data: { turbo_submits_with: t(".submitting") } %>
    <% end %>

    <p class="meta">
      <%= t(".no_account") %>
      <%= link_to t(".sign_up"), new_user_registration_path, class: "auth-link" %>
    </p>
  </div>
</div>
