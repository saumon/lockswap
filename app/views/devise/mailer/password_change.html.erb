<%# 034 FR-039: a notice, not an action. No link that could change the account,
    and never the password itself. The time is a measured value, so it is set
    in the mono face. %>
<h1 style="margin: 0 0 16px 0; font-size: 22px; line-height: 1.25; letter-spacing: -0.02em; color: <%= mail_color(:ink) %>;"><%= t("mailer.password_change.heading") %></h1>

<p style="margin: 0 0 16px 0;"><%= t("mailer.password_change.body_html", time: tag.span(l(Time.current, format: :long), style: "font-family: #{MailerHelper::MAIL_FONT_MEASURED};")) %></p>

<p style="margin: 0; font-weight: 700;"><%= t("mailer.password_change.not_you") %></p>
