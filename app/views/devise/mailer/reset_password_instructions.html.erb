<%# 034 User Story 3, contracts/emails.md: the reset link — 6 hours, once. %>
<h1 style="margin: 0 0 16px 0; font-size: 22px; line-height: 1.25; letter-spacing: -0.02em; color: <%= mail_color(:ink) %>;"><%= t("mailer.reset_password_instructions.heading") %></h1>

<p style="margin: 0 0 12px 0;"><%= t("mailer.reset_password_instructions.why") %></p>
<p style="margin: 0;"><%= t("mailer.reset_password_instructions.what") %></p>

<%= render "devise/mailer/action", label: t("mailer.reset_password_instructions.button"),
      url: edit_password_url(@resource, reset_password_token: @token),
      validity: t("mailer.reset_password_instructions.validity") %>

<p style="margin: 0; font-size: 14px; color: <%= mail_color(:ink_muted) %>;"><%= t("mailer.reset_password_instructions.not_you") %></p>
