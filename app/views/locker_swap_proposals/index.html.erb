<% content_for :title, "Proposal history" %>

<%# 004 FR-015: every proposal this user sent or received, with its date, where
    it ended up, and why if somebody said. Read-only by design — the homepage is
    where proposals are acted on; this is where they are looked back at. %>
<div class="stack">
  <div id="swap-proposal-history" class="card stack-tight">
    <h1 class="page-title">Your swap proposals</h1>

    <% if @proposals.any? %>
      <%# The table is the one thing here allowed to scroll sideways on a narrow
          screen; the page itself must not. %>
      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">Direction</th>
              <th scope="col">Person</th>
              <th scope="col">Sent</th>
              <th scope="col">Status</th>
              <th scope="col">Comment</th>
              <%# 005 FR-005: its own column, not folded into the one above — one
                  says why a person answered as they did, the other what was on
                  the table, and a row can have both (FR-008). %>
              <th scope="col">Locker details</th>
            </tr>
          </thead>

          <tbody>
            <% @proposals.each do |proposal| %>
              <% sent = proposal.requester_id == current_user.id %>
              <% row_id = "swap-proposal-history-row-#{proposal.id}" %>
              <tr id="<%= row_id %>">
                <td class="strong"><%= sent ? "Sent" : "Received" %></td>
                <td><%= sent ? proposal.recipient.email : proposal.requester.email %></td>
                <td class="meta"><%= l proposal.created_at, format: :long %></td>

                <%# "accepted" is the spec's "exchange in progress"; the column
                    says what a reader would call it, not what the column stores. %>
                <%# 008 FR-025: the badge tint is decoration on top of the label —
                    the status word itself is what carries the meaning. %>
                <td id="<%= row_id %>-status">
                  <span class="badge <%= history_status_badge_class(proposal) %>">
                    <%= proposal.accepted? ? "Exchange in progress" : proposal.status.capitalize %>
                  </span>
                </td>

                <td id="<%= row_id %>-comment"
                    class="<%= "detail-value-empty" if proposal.decline_comment.blank? %>">
                  <%= proposal.decline_comment.presence || "—" %>
                </td>

                <%# FR-005: filled in for every row, whatever became of it, so
                    the history never depends on anyone having written it down. %>
                <td id="<%= row_id %>-locker-details" class="meta">
                  <%= proposal.floor_and_locker_summary %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%# Acceptance Scenario 4: never having proposed anything is an ordinary
          state to report, not an error. %>
      <p id="swap-proposal-history-empty" class="empty-state">
        You have not sent or received any swap proposals yet.
      </p>
    <% end %>
  </div>
</div>
